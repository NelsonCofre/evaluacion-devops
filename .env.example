# Variables centralizadas - copiar a .env
VITE_API_URL=

# Proxy Nginx (EC2: IP privada del backend)
BACKEND_VENTAS_HOST=ventas:8081
BACKEND_DESPACHO_HOST=despacho:8082

# Spring Boot
SERVER_PORT=
SPRING_PROFILES_ACTIVE=prod

# MySQL local (docker compose)
DB_ENDPOINT=mysql
DB_PORT=3306
DB_NAME=despacho_db
DB_USERNAME=despacho_user
DB_PASSWORD=despacho_pass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3307

# MySQL AWS RDS (produccion EC2)
# DB_ENDPOINT=xxx.rds.amazonaws.com

# Docker Hub
DOCKER_USERNAME=tu_usuario
